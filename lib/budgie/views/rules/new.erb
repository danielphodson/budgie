<h2>New Rule</h2>

<div class="form-card">
  <% if @error %>
    <div class="error-banner"><%= h @error %></div>
  <% end %>

  <form method="post" action="/rules">
    <div class="form-group">
      <label for="name">Name</label>
      <input type="text" id="name" name="name"
             value="<%= h @submitted["name"] %>"
             placeholder="e.g. Mortgage">
    </div>

    <div class="form-group">
      <label for="account">Account</label>
      <input type="text" id="account" name="account"
             value="<%= h @submitted["account"] %>"
             placeholder="e.g. Visa">
    </div>

    <div class="form-group">
      <label for="output_col">Output column</label>
      <input type="text" id="output_col" name="output_col"
             value="<%= h @submitted["output_col"] %>"
             placeholder="e.g. Category">
    </div>

    <div class="form-group">
      <label for="output_value">Output value</label>
      <input type="text" id="output_value" name="output_value"
             value="<%= h @submitted["output_value"] %>"
             placeholder="e.g. Mortgage">
    </div>

    <fieldset>
      <legend>First pattern</legend>

      <div class="form-group">
        <label for="source_col">Source column</label>
        <input type="text" id="source_col" name="source_col"
               value="<%= h @submitted["source_col"] %>"
               placeholder="e.g. Description">
        <p class="field-hint">The CSV column header to match against.</p>
      </div>

      <div class="form-group">
        <label for="pattern">Pattern</label>
        <input type="text" id="pattern" name="pattern"
               value="<%= h @submitted["pattern"] %>"
               placeholder="e.g. Loan repayment"
               class="<%= @error ? "input-error" : "" %>">
        <p class="field-hint">Plain text substring match. Case-insensitive.</p>
      </div>
    </fieldset>

    <div class="actions">
      <button type="submit" class="btn btn-primary">Create rule</button>
      <a href="/rules" class="btn btn-secondary">Cancel</a>
    </div>
  </form>
</div>
