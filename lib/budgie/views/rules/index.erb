<div class="page-header">
  <h2>Categories</h2>
  <a href="/categories/new" class="btn btn-primary">+ New category</a>
</div>

<% if @categories.empty? %>
  <p class="empty">No categories defined yet. <a href="/categories/new">Create the first one</a>.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Monthly budget</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= h category.output_value %></td>
          <td><%= category.monthly_budget ? "$#{"%.2f" % category.monthly_budget}" : "" %></td>
          <td>
            <div class="actions">
              <a href="/categories/<%= category.id %>/copy" class="btn btn-secondary">Copy</a>
              <a href="/categories/<%= category.id %>/edit" class="btn btn-secondary">Edit</a>
              <form method="post" action="/categories/<%= category.id %>/delete"
                    onsubmit="return confirm('Delete \u201c<%= h category.output_value %>\u201d?')">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
