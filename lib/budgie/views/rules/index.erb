<div class="page-header">
  <h2>Rules</h2>
  <a href="/rules/new" class="btn btn-primary">+ New rule</a>
</div>

<% if @rules.empty? %>
  <p class="empty">No rules defined yet. <a href="/rules/new">Create the first one</a>.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Account</th>
        <th>Source col</th>
        <th>Pattern</th>
        <th>Output col</th>
        <th>Output value</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @rules.each do |rule| %>
        <tr>
          <td><%= rule.id %></td>
          <td><%= h rule.name %></td>
          <td><%= h rule.account %></td>
          <td><%= h rule.source_col %></td>
          <td><code><%= h rule.pattern %></code></td>
          <td><%= h rule.output_col %></td>
          <td><%= h rule.output_value %></td>
          <td>
            <div class="actions">
              <a href="/rules/<%= rule.id %>/copy" class="btn btn-secondary">Copy</a>
              <a href="/rules/<%= rule.id %>/edit" class="btn btn-secondary">Edit</a>
              <form method="post" action="/rules/<%= rule.id %>/delete"
                    onsubmit="return confirm('Delete \u201c<%= h rule.name %>\u201d?')">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
