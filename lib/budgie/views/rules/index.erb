<div class="page-header">
  <h2>Rules</h2>
  <a href="/rules/new" class="btn btn-primary">+ New rule</a>
</div>

<% if @rules.empty? %>
  <p class="empty">No rules defined yet. <a href="/rules/new">Create the first one</a>.</p>
<% else %>
  <table>
    <thead>
      <tr>
        <th>Category</th>
        <th>Monthly budget</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @rules.each do |rule| %>
        <tr>
          <td><%= h rule.output_value %></td>
          <td><%= rule.monthly_budget ? "$#{"%.2f" % rule.monthly_budget}" : "" %></td>
          <td>
            <div class="actions">
              <a href="/rules/<%= rule.id %>/copy" class="btn btn-secondary">Copy</a>
              <a href="/rules/<%= rule.id %>/edit" class="btn btn-secondary">Edit</a>
              <form method="post" action="/rules/<%= rule.id %>/delete"
                    onsubmit="return confirm('Delete \u201c<%= h rule.output_value %>\u201d?')">
                <button type="submit" class="btn btn-danger">Delete</button>
              </form>
            </div>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>
